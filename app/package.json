{
  "name": "vocalis",
  "productName": "Vocalis",
  "version": "0.2.4",
  "description": "Real-time AI voice changer (RVC) for Windows",
  "main": "out/main/index.js",
  "author": "Vocalis",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "postdist": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/clean-releases.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "allowScripts": {
    "electron@45.2.1": true
  },
  "homepage": "https://github.com/melekhovv/vocalis",
  "repository": {
    "type": "git",
    "url": "https://github.com/melekhovv/vocalis.git"
  },
  "bugs": {
    "url": "https://github.com/melekhovv/vocalis/issues"
  }
}
